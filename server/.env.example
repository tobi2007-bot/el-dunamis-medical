# Copy this file to .env (or set these in your host's environment settings)
# and fill in real values. Never commit the real .env file.

# ── Core ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password

# ── AI Chat (Careers page) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Production ───────────────────────────────────────────────────────────
# With NODE_ENV=production the server refuses to start unless JWT_SECRET
# (32+ chars) and ADMIN_PASS are set.
NODE_ENV=production
# Only needed if a different domain must call the API (leave unset otherwise):
# CORS_ORIGIN=https://your-domain.com
